{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pendik-erzurumlular",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/yonetim", "/yonetim/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dernek-basvurular",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "ADMIN_EMAIL": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "TURNSTILE_SITE_KEY": ""
  }
}
